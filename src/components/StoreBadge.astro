---
import site from '../data/site.json';
const { store, size = 19 } = Astro.props;
---
<img class="store" src={site.storeIcon.replace('{store}', store)} alt={store} title={store} width={size} height={size} loading="lazy" />

<style>
  .store { display: block; background: var(--store-bg); border-radius: var(--radius); opacity: var(--img-opacity); }
</style>

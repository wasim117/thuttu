---
import Icon from './Icon.astro';
import StoreBadge from './StoreBadge.astro';
import { ago, rupees, url } from '../lib/format.js';
const { deal } = Astro.props;
---
<article class="deal card">
  <a class="thumb" href={deal.url} rel="nofollow noopener">
    {deal.pinned && <span class="pinned">PINNED</span>}
    <img src={url(`${deal.image}`)} alt="" width="80" height="62" loading="lazy" />
    <span class="get"><Icon name="cart" /> Get Deal</span>
  </a>
  <div class="body">
    <div class="title-row">
      <a class="title" href={deal.url} rel="nofollow noopener">{deal.title}</a>
      <button class="menu" aria-label="More options"><Icon name="down" /></button>
    </div>
    <div class="price-row">
      <span class="off"><Icon name="arrowDown" />{deal.discount}%</span>
      <span class="price">{rupees(deal.price)}</span>
      <span class="old">{rupees(deal.oldPrice)}</span>
    </div>
    <div class="stats">
      <span><Icon name="like" />{deal.likes}</span>
      <span><Icon name="eye" />{deal.views}</span>
      <span><Icon name="clock" />{ago(deal.minsAgo)}</span>
      <span><Icon name="comment" />{deal.comments}</span>
      <StoreBadge store={deal.store} />
    </div>
  </div>
  {deal.hot && <span class="hot"><Icon name="fire" /> HOT</span>}
</article>

<style>
  .deal {
    position: relative; display: flex; gap: 10px;
    padding: 10px 14px 10px 8px; min-height: 114px;
  }
  .thumb {
    position: relative; flex: none; width: 90px;
    display: flex; flex-direction: column; align-items: center;
    border: 1px solid #eee; border-radius: 2px; overflow: hidden;
  }
  .thumb img { width: 100%; height: 72px; object-fit: contain; background: #fff; }
  .get {
    width: 100%; background: #eef0f2; font-size: 11.5px; text-align: center; padding: 2px 0;
    white-space: nowrap; color: #333;
  }
  .pinned {
    position: absolute; top: 0; left: 0; right: 0; z-index: 1;
    background: var(--pinned); color: #fff; font-size: 10px; letter-spacing: 2px; text-align: center;
  }
  .body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
  .title-row { display: flex; gap: 6px; }
  .title {
    flex: 1; font-size: 14px; line-height: 21px; color: #333;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .menu { border: 0; background: none; padding: 0; font-size: 20px; height: 20px; color: #444; cursor: pointer; }
  .price-row { display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; font-size: 13px; }
  .off { color: #444; }
  .off :global(svg) { font-size: 11px; }
  .price { color: var(--blue); font-weight: 500; text-align: center; }
  .old { text-align: right; color: #444; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr) auto; align-items: center; font-size: 11.5px; color: var(--muted); }
  .stats span { display: flex; align-items: center; gap: 3px; }
  .stats span:nth-child(2) { justify-content: center; }
  .stats span:nth-child(3) { justify-content: center; }
  .stats span:nth-child(4) { justify-content: flex-end; padding-right: 22px; }
  .hot {
    position: absolute; top: 4px; right: 4px;
    background: var(--hot); color: #fff; font-size: 10px; letter-spacing: 1.5px;
    padding: 1px 6px; border-radius: 2px;
  }
</style>

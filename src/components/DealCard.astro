---
import Icon from './Icon.astro';
import StoreBadge from './StoreBadge.astro';
import { ago, rupees, url, IMG_FALLBACK } from '../lib/format.js';
const { deal, eager = false } = Astro.props;
---
<article class="deal">
  <a class="thumb" href={deal.url} rel="nofollow noopener sponsored">
    <img
      src={url(deal.image)}
      data-fallback={deal.imageFallback || undefined}
      onerror={deal.imageFallback ? IMG_FALLBACK : undefined}
      alt={deal.title}
      width="118"
      height="118"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
    <span class="get"><Icon name="cart" /> Get Deal</span>
    {deal.pinned && <span class="pinned">PINNED</span>}
  </a>
  <StoreBadge store={deal.store} />
  <a class="title" href={deal.url} rel="nofollow noopener sponsored">{deal.title}</a>
  <button class="menu" aria-label="More options"><Icon name="chevronDown" /></button>
  {deal.price && (
    <>
      <span class="off">{deal.discount && <><Icon name="arrowDown" />{deal.discount}%</>}</span>
      <span class="price">{rupees(deal.price)}</span>
      <span class="old">{deal.oldPrice && rupees(deal.oldPrice)}</span>
    </>
  )}
  <span class="likes"><Icon name="like" />{deal.likes}</span>
  <span class="views"><Icon name="eye" />{deal.views}</span>
  <span class="time"><Icon name="clock" />{ago(deal.minsAgo)}</span>
  <span class="comments"><Icon name="comment" />{deal.comments}</span>
  {deal.hot && <span class="hot"><Icon name="fire" /> HOT</span>}
</article>

<style>
  .deal {
    position: relative; display: grid;
    background: var(--bg-content-color); border-radius: var(--radius); box-shadow: var(--box-shadow);
    color: var(--text-color);
  }
  .thumb { position: relative; display: block; grid-area: thumb; }
  .thumb img { display: block; width: 100%; object-fit: contain; background: var(--img-bg); opacity: var(--img-opacity); border-radius: var(--radius); }
  .get {
    position: absolute; left: 0; display: flex; align-items: center; gap: 4px;
    background: var(--bg-color); color: var(--title-text); font-size: 11.5px; white-space: nowrap;
  }
  .get :global(svg) { font-size: 13px; }
  .pinned {
    position: absolute; background: var(--pinned-color); color: #fff;
    font-size: 10.5px; letter-spacing: 2px; padding: 0 6px; border-radius: var(--radius);
  }
  .deal :global(.store) { position: absolute; }
  .title {
    grid-area: title; color: var(--title-text); font-size: 14px; line-height: 21px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .menu { grid-area: menu; justify-self: end; border: 0; background: none; padding: 0; font-size: 22px; height: 22px; color: var(--text-color); cursor: pointer; display: grid; justify-content: end; }
  .off { grid-area: off; color: var(--percent-text); font-size: 13px; white-space: nowrap; }
  .off :global(svg) { font-size: 11px; }
  .price { grid-area: price; color: var(--deal-price); font-weight: 500; font-size: 14px; text-align: center; white-space: nowrap; }
  .old { grid-area: old; color: var(--percent-text); font-size: 13px; text-align: right; white-space: nowrap; }
  .likes, .views, .time, .comments { display: flex; align-items: center; gap: 3px; font-size: 11.5px; color: var(--muted); }
  .likes { grid-area: likes; }
  .views { grid-area: views; justify-content: center; }
  .time { grid-area: time; justify-content: center; white-space: nowrap; }
  .comments { grid-area: comments; justify-content: flex-end; }
  .hot {
    position: absolute; top: 4px; right: 4px; z-index: 1;
    background: var(--badge-color); color: #fff; font-size: 10.5px; letter-spacing: 1.5px;
    padding: 1px 6px; border-radius: var(--radius);
  }

  /* List mode: thumbnail left, details right, 113px tall. */
  :global(.navpane.list) .deal {
    height: 113px; padding: 8px 10px 8px 8px; column-gap: 10px;
    grid-template-columns: 90px 0.9fr 1fr 1.2fr 1fr;
    grid-template-rows: 44px 26px 1fr;
    grid-template-areas:
      'thumb title title title menu'
      'thumb off price old old'
      'thumb likes views time comments';
  }
  :global(.navpane.list) .thumb { height: 97px; }
  :global(.navpane.list) .thumb img { height: 74px; }
  :global(.navpane.list) .get { bottom: 0; width: 90px; height: 22px; padding-left: 10px; border-radius: 0 0 var(--radius) var(--radius); }
  :global(.navpane.list) .pinned { top: 0; left: 0; right: 0; text-align: center; border-radius: var(--radius) var(--radius) 0 0; }
  :global(.navpane.list) .deal :global(.store) { right: 12px; bottom: 9px; }
  :global(.navpane.list) .old { padding-right: 18px; }
  :global(.navpane.list) .views, :global(.navpane.list) .time, :global(.navpane.list) .comments { justify-content: flex-start; }
  :global(.navpane.list) .likes, :global(.navpane.list) .views, :global(.navpane.list) .time, :global(.navpane.list) .comments { align-self: end; padding-bottom: 2px; }

  /* Grid mode: image on top, 270px tall. */
  :global(.navpane.grid) .deal {
    height: 270px; padding: 0 10px 8px; column-gap: 4px;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    grid-template-rows: 152px 52px 30px 1fr;
    grid-template-areas:
      'thumb thumb thumb thumb'
      'title title title menu'
      'off price price old'
      'likes views time comments';
  }
  :global(.navpane.grid) .thumb { margin: 0 -10px; height: 145px; padding-top: 16px; }
  :global(.navpane.grid) .thumb img { height: 112px; background: transparent; }
  :global(.navpane.grid) .get { top: 135px; left: 2px; height: 21px; padding: 0 10px 0 8px; border-radius: 0 5px 5px 0; }
  :global(.navpane.grid) .pinned { top: 118px; left: 50%; transform: translateX(-50%); }
  :global(.navpane.grid) .deal :global(.store) { top: 129px; right: 12px; width: 25px; height: 25px; }
  :global(.navpane.grid) .title { align-self: center; }
  :global(.navpane.grid) .menu { align-self: start; padding-top: 6px; }
  :global(.navpane.grid) .off, :global(.navpane.grid) .price, :global(.navpane.grid) .old { align-self: center; }
  :global(.navpane.grid) .likes, :global(.navpane.grid) .views, :global(.navpane.grid) .time, :global(.navpane.grid) .comments { align-self: end; }
  :global(.navpane.grid) .time { font-size: 11px; }
  @media (max-width: 669px) {
    :global(.navpane.grid) .off, :global(.navpane.grid) .old { font-size: 12px; }
    :global(.navpane.grid) .off :global(svg) { display: none; }
  }
</style>

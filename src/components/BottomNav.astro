---
import { url } from '../lib/format.js';
import { routes } from '../lib/routes.js';
import Icon from './Icon.astro';
const items = [
  ['New', 'home'], ['Hot', 'fire'], ['Popular', 'megaphone'], ['Comments', 'forum'], ['More', 'more'],
];
const { active = 'New' } = Astro.props;
---
<nav class="bottom">
  {items.map(([label, icon]) => (
    <a href={label in routes ? url(routes[label]) : '#'} class:list={{ active: label === active }}>
      <Icon name={icon} />
      <span>{label}</span>
    </a>
  ))}
</nav>

<style>
  .bottom { display: none; }
  @media (max-width: 1109px) {
    .bottom {
      position: fixed; inset: auto 0 0 0; z-index: 10; height: var(--bnav-height);
      display: grid; grid-template-columns: repeat(5, 1fr);
      background: var(--bg-content-color); box-shadow: 0 -1px 3px rgba(0,0,0,.12);
    }
    a { display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 11px; color: var(--muted); }
    a :global(svg) { font-size: 22px; }
    a.active { color: var(--primary-color); }
  }
</style>

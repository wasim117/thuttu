---
// One live-activity row: "<label> X ago" tag, small image, title, prices, store.
import StoreBadge from './StoreBadge.astro';
import { ago, rupees, url, IMG_FALLBACK } from '../lib/format.js';
const { deal: d, label = 'new deal posted', minsAgo = d.minsAgo } = Astro.props;
---
<div class="item">
  <small>{label} {ago(minsAgo)} ago</small>
  <a class="row" href={d.url} rel="nofollow noopener sponsored">
    <img
      src={url(d.thumb ?? d.image)}
      data-fallback={d.thumbFallback || undefined}
      onerror={d.thumbFallback ? IMG_FALLBACK : undefined}
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
    />
    <div class="body">
      <p>{d.title}</p>
      <div class="nums">
        {d.discount && <span>{d.discount}% Off</span>}
        {d.price && <b>{rupees(d.price)}</b>}
        {d.oldPrice && <s>{rupees(d.oldPrice)}</s>}
        <StoreBadge store={d.store} />
      </div>
    </div>
  </a>
</div>

<style>
  .item { min-width: 0; }
  small {
    display: inline-block; background: var(--bg-content-color); color: var(--text-color);
    font-size: 11.5px; padding: 0 8px; border-radius: var(--radius) var(--radius) 0 0;
  }
  .row { display: flex; gap: 10px; padding: 4px 0; }
  img { flex: none; width: 64px; height: 64px; object-fit: contain; background: var(--img-bg); opacity: var(--img-opacity); border-radius: 8px; }
  .body { flex: 1; min-width: 0; }
  p {
    margin: 0 0 6px; font-size: 14px; line-height: 20px; color: var(--title-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .nums { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--percent-text); }
  .nums b { color: var(--deal-price); font-weight: 500; }
  .nums :global(.store) { margin-left: auto; }
</style>

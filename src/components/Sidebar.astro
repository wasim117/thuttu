---
import Icon from './Icon.astro';
import StoreBadge from './StoreBadge.astro';
import { ago, rupees, url } from '../lib/format.js';
const { links, updates } = Astro.props;
---
<aside class="sidebar card">
  <button class="signin">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="#5f6368"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6z" fill="#5f6368"/></svg>
    Sign in
  </button>

  <div class="disc">
    <h2>Discover more</h2>
    {links.map((l) => <a href="#">{l}<Icon name="chevron" /></a>)}
  </div>

  <div class="live-head"><Icon name="live" /> Live Updates</div>
  <ul class="live">
    {updates.map((d) => (
      <li>
        <small>new deal posted {ago(d.minsAgo)} ago</small>
        <a class="row" href={d.url} rel="nofollow noopener">
          <img src={url(`${d.image}`)} alt="" width="56" height="44" loading="lazy" />
          <div>
            <p>{d.title}</p>
            <div class="nums">
              <span>{d.discount}% Off</span>
              <b>{rupees(d.price)}</b>
              <s>{rupees(d.oldPrice)}</s>
              <StoreBadge store={d.store} />
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .sidebar { align-self: start; position: sticky; top: calc(var(--header-h) + 10px); padding: 12px 0; border: 0; background: transparent; }
  .signin {
    width: 100%; height: 42px; border: 0; background: #e8eaed; font: inherit; font-size: 14px; color: #333;
    display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; border-radius: 2px;
  }
  .signin svg { font-size: 18px; }
  .disc { margin: 40px 12px 0; border: 1px solid #dadce0; border-radius: 2px; background: var(--card); }
  .disc h2 { margin: 0; padding: 10px 22px; background: #dde6f6; font-size: 18px; font-weight: 500; color: #333; }
  .disc a {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 22px; border-top: 1px solid #eee; font-size: 17px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .disc a :global(svg) { font-size: 24px; color: #777; }
  .live-head {
    margin: 40px 0 6px; padding: 10px 12px; background: #e8eaed;
    display: flex; align-items: center; gap: 8px; font-size: 16px;
  }
  .live-head :global(svg) { font-size: 20px; }
  .live { list-style: none; margin: 0; padding: 0; }
  .live li { margin-bottom: 8px; }
  .live small { display: inline-block; background: #e8eaed; font-size: 11px; padding: 0 8px; }
  .row { display: flex; gap: 10px; background: var(--card); padding: 6px 10px; }
  .row img { flex: none; object-fit: contain; }
  .row > div { flex: 1; min-width: 0; }
  .row p {
    margin: 0 0 4px; font-size: 14px; line-height: 20px; color: #333;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .nums { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--muted); }
  .nums b { color: var(--blue); font-weight: 500; }
  .nums :global(.store) { margin-left: auto; }
</style>

---
import Icon from './Icon.astro';
import StoreBadge from './StoreBadge.astro';
import { ago, rupees, url, IMG_FALLBACK } from '../lib/format.js';
const { links, updates } = Astro.props;
---
<aside class="sidebar">
  <div class="box">
    <button class="signin">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 4-6 8-6s8 2 8 6z" /></svg>
      Sign in
    </button>

    <div class="disc">
      <h2>Discover more</h2>
      {links.map((l) => <a href="#">{l}<Icon name="chevron" /></a>)}
    </div>
  </div>

  <div class="live-head"><Icon name="live" /> Live Updates</div>
  <ul class="live">
    {updates.map((d) => (
      <li>
        <small>new deal posted {ago(d.minsAgo)} ago</small>
        <a class="row" href={d.url} rel="nofollow noopener sponsored">
          <img
            src={url(d.thumb ?? d.image)}
            data-fallback={d.thumbFallback || undefined}
            onerror={d.thumbFallback ? IMG_FALLBACK : undefined}
            alt=""
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          />
          <div>
            <p>{d.title}</p>
            <div class="nums">
              {d.discount && <span>{d.discount}% Off</span>}
              {d.price && <b>{rupees(d.price)}</b>}
              {d.oldPrice && <s>{rupees(d.oldPrice)}</s>}
              <StoreBadge store={d.store} />
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .sidebar { align-self: start; position: sticky; top: calc(var(--topbar-height) + 14px); }
  .box { background: var(--bg-content-color); border-radius: var(--radius); box-shadow: var(--box-shadow); padding: 14px 14px 18px; }
  .signin {
    width: 100%; height: 42px; border: 0; background: var(--bg-color); font-size: 14.5px; color: var(--text-color);
    display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; border-radius: var(--radius);
  }
  .signin svg { font-size: 18px; color: var(--muted); }
  .disc { margin-top: 30px; border: 1px solid var(--pill-border); border-radius: var(--radius); overflow: hidden; }
  .disc h2 { margin: 0; padding: 10px 20px; background: color-mix(in srgb, var(--primary-color) 15%, var(--bg-content-color)); font-size: 18px; font-weight: 500; color: var(--text-color); }
  .disc a {
    display: flex; align-items: center; justify-content: space-between;
    padding: 15px 20px; border-top: 1px solid var(--pill-border); font-size: 17px; color: var(--text-color);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .disc a :global(svg) { font-size: 24px; color: var(--muted); }
  .live-head {
    margin: 16px 0 8px; padding: 10px 12px; background: var(--bg-content-color); border-radius: var(--radius);
    display: flex; align-items: center; gap: 8px; font-size: 16px; color: var(--text-color);
  }
  .live-head :global(svg) { font-size: 20px; }
  .live { list-style: none; margin: 0; padding: 0; }
  .live li { margin-bottom: 10px; border-bottom: 1px solid var(--pill-border); padding-bottom: 6px; }
  .live small { display: inline-block; background: var(--bg-content-color); color: var(--text-color); font-size: 11.5px; padding: 0 8px; border-radius: var(--radius) var(--radius) 0 0; }
  .row { display: flex; gap: 10px; padding: 4px 0; }
  .row img { flex: none; width: 64px; height: 64px; object-fit: contain; background: var(--img-bg); opacity: var(--img-opacity); border-radius: 8px; }
  .row > div { flex: 1; min-width: 0; }
  .row p {
    margin: 0 0 6px; font-size: 14px; line-height: 20px; color: var(--title-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .nums { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--percent-text); }
  .nums b { color: var(--deal-price); font-weight: 500; }
  .nums :global(.store) { margin-left: auto; }
</style>

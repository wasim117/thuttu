---
import Icon from './Icon.astro';
import LiveItem from './LiveItem.astro';
// Pass `updates` for the Live Updates feed, or `searches` for Recently Browsed.
const { links, updates = [], searches } = Astro.props;
---
<aside class="sidebar">
  <div class="box">
    <button class="signin">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 4-6 8-6s8 2 8 6z" /></svg>
      Sign in
    </button>

    <div class="disc">
      <h2>Discover more</h2>
      {links.map((l) => <a href="#">{l}<Icon name="chevron" /></a>)}
    </div>
  </div>

  {searches ? (
    <div class="recent">
      <h2>Recently Browsed</h2>
      <div class="terms">{searches.map((t) => <a href="#">{t}</a>)}</div>
    </div>
  ) : (
    <>
      <div class="live-head"><Icon name="live" /> Live Updates</div>
      <ul class="live">
        {updates.map((d) => <li><LiveItem deal={d} /></li>)}
      </ul>
    </>
  )}
</aside>

<style>
  .sidebar { align-self: start; position: sticky; top: calc(var(--topbar-height) + 14px); }
  .box { background: var(--bg-content-color); border-radius: var(--radius); box-shadow: var(--box-shadow); padding: 14px 14px 18px; }
  .signin {
    width: 100%; height: 42px; border: 0; background: var(--bg-color); font-size: 14.5px; color: var(--text-color);
    display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; border-radius: var(--radius);
  }
  .signin svg { font-size: 18px; color: var(--muted); }
  .disc { margin-top: 30px; border: 1px solid var(--pill-border); border-radius: var(--radius); overflow: hidden; }
  .disc h2 { margin: 0; padding: 10px 20px; background: color-mix(in srgb, var(--primary-color) 15%, var(--bg-content-color)); font-size: 18px; font-weight: 500; color: var(--text-color); }
  .disc a {
    display: flex; align-items: center; justify-content: space-between;
    padding: 15px 20px; border-top: 1px solid var(--pill-border); font-size: 17px; color: var(--text-color);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .disc a :global(svg) { font-size: 24px; color: var(--muted); }
  .live-head {
    margin: 16px 0 8px; padding: 10px 12px; background: var(--bg-content-color); border-radius: var(--radius);
    display: flex; align-items: center; gap: 8px; font-size: 16px; color: var(--text-color);
  }
  .live-head :global(svg) { font-size: 20px; }
  .live { list-style: none; margin: 0; padding: 0; }
  .live li { margin-bottom: 10px; border-bottom: 1px solid var(--pill-border); padding-bottom: 6px; }
  .recent { margin-top: 16px; background: var(--bg-content-color); border-radius: var(--radius); box-shadow: var(--box-shadow); padding-bottom: 14px; }
  .recent h2 { margin: 0 0 12px; padding: 10px 20px; background: var(--bg-color); font-size: 16px; font-weight: 400; color: var(--text-color); }
  .terms { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 10px; padding: 0 12px; }
  .terms a { background: var(--bg-color); color: var(--text-color); font-size: 14px; padding: 3px 10px; border-radius: var(--radius); }
</style>

---
import Icon from './Icon.astro';
import LiveItem from './LiveItem.astro';
const { updates = [], searches } = Astro.props;
---
<aside class="sidebar">
  {searches ? (
    <div class="recent">
      <h2>Recently Browsed</h2>
      <div class="terms">{searches.map((t) => <a href="#">{t}</a>)}</div>
    </div>
  ) : (
    <>
      <div class="live-head"><Icon name="live" /> Live Updates</div>
      <ul class="live">
        {updates.map((d) => <li><LiveItem deal={d} /></li>)}
      </ul>
    </>
  )}
</aside>

<style>
  .sidebar { align-self: start; position: sticky; top: calc(var(--topbar-height) + 14px); }
  .live-head {
    margin: 16px 0 8px; padding: 10px 12px; background: var(--bg-content-color); border-radius: var(--radius);
    display: flex; align-items: center; gap: 8px; font-size: 16px; color: var(--text-color);
  }
  .live-head :global(svg) { font-size: 20px; }
  .live { list-style: none; margin: 0; padding: 0; }
  .live li { margin-bottom: 10px; border-bottom: 1px solid var(--pill-border); padding-bottom: 6px; }
  .recent { margin-top: 16px; background: var(--bg-content-color); border-radius: var(--radius); box-shadow: var(--box-shadow); padding-bottom: 14px; }
  .recent h2 { margin: 0 0 12px; padding: 10px 20px; background: var(--bg-color); font-size: 16px; font-weight: 400; color: var(--text-color); }
  .terms { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 10px; padding: 0 12px; }
  .terms a { background: var(--bg-color); color: var(--text-color); font-size: 14px; padding: 3px 10px; border-radius: var(--radius); }
</style>

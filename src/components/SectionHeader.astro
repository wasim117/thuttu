---
import Icon from './Icon.astro';
const { title } = Astro.props;
---
<div class="sh card">
  <h1>{title}</h1>
  <button aria-label="Toggle grid view"><Icon name="grid" /></button>
</div>

<style>
  .sh { display: flex; align-items: center; justify-content: space-between; height: 52px; padding: 0 20px; }
  h1 { margin: 0; font-size: 17px; font-weight: 400; }
  button { border: 0; background: none; font-size: 24px; color: #555; padding: 0; cursor: pointer; display: grid; }
</style>

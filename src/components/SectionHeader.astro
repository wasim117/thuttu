---
import Icon from './Icon.astro';
const { title, pane } = Astro.props;
---
<div class="sh card">
  <h1>{title}</h1>
  <button class="view-toggle" data-pane={pane} aria-label="Switch between list and grid view" title="Switch view">
    <span class="to-grid"><Icon name="viewGrid" /></span>
    <span class="to-list"><Icon name="viewList" /></span>
  </button>
</div>

<style>
  .sh { display: flex; align-items: center; justify-content: space-between; height: 50px; padding: 0 20px; }
  h1 { margin: 0; font-size: 17px; font-weight: 400; color: var(--text-color); }
  .view-toggle { border: 0; background: none; font-size: 24px; color: var(--muted); padding: 4px; cursor: pointer; display: grid; }
  /* Show the icon for the view you would switch to. */
  .to-list { display: none; }
  :global(html[data-view='grid']) .to-grid { display: none; }
  :global(html[data-view='grid']) .to-list { display: inline; }
</style>

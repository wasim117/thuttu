---
import DealsPage from '../components/DealsPage.astro';
import site from '../data/site.json';
import { getDeals } from '../lib/deals.js';

const deals = await getDeals({ sort: 'new', perPage: 24 });
// Pinned deals first, then newest.
const sorted = [...deals].sort((a, b) => Number(b.pinned) - Number(a.pinned) || a.minsAgo - b.minsAgo);
---
<DealsPage
  heading="New Deals (Latest)"
  active="New"
  banner={site.banner}
  deals={sorted}
  updates={sorted.filter((d) => !d.pinned).slice(0, 8)}
/>
